# Python Virtual Environment
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Rust Build Output (Heavy binary targets)
target/
engine/target/
**/*.rs.bk
Cargo.lock

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride
._*

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Large Benchmark Data (Can be regenerated with python data/generate_dataset.py)
data/*.csv

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
